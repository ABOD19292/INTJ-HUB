-- LOG SYSTEM
--------------------------------------------------------

local logs = {}

local function addLog(message, color)
	table.insert(logs, message)

	if #logs > 30 then
		table.remove(logs, 1)
	end

	logLabel.Text = table.concat(logs, "\n")
	logLabel.TextColor3 = color or Color3.fromRGB(135, 200, 255)

	task.defer(function()
		logFrame.CanvasPosition = Vector2.new(
			0,
			math.max(0, logLabel.AbsoluteSize.Y - logFrame.AbsoluteSize.Y)
		)
	end)
end

--------------------------------------------------------
-- STATISTICS UPDATE
--------------------------------------------------------

local function updateStats()
	local elapsed = 0

	if State.StartTime > 0 then
		elapsed = os.clock() - State.StartTime
	end

	local throughput = 0

	if elapsed > 0 then
		throughput = State.Generated / elapsed
	end

	local successRate = 0

	if State.Generated > 0 then
		successRate =
			(State.Accepted / State.Generated) * 100
	end

	statsLabel.Text = string.format(
		"Generated : %d\n" ..
		"Accepted  : %d\n" ..
		"Blocked   : %d\n" ..
		"Errors    : %d\n" ..
		"Success   : %.1f%%\n" ..
		"Speed     : %.2f/s",
		State.Generated,
		State.Accepted,
		State.Blocked,
		State.Errors,
		successRate,
		throughput
	)
end

--------------------------------------------------------
-- RATE LIMITER
--------------------------------------------------------

local function cleanupMessageTimes()
	local now = os.clock()

	for i = #State.MessageTimes, 1, -1 do
		if now - State.MessageTimes[i] > Config.RateWindow then
			table.remove(State.MessageTimes, i)
		end
	end
end

local function checkRateLimit()
	cleanupMessageTimes()

	if #State.MessageTimes >= Config.RateLimit then
		return false
	end

	table.insert(State.MessageTimes, os.clock())

	return true
end

--------------------------------------------------------
-- RESET
--------------------------------------------------------

local function reset()
	State.Running = false
	State.StopRequested = false

	State.Generated = 0
	State.Accepted = 0
	State.Blocked = 0
	State.Errors = 0

	State.StartTime = 0
	State.EndTime = 0

	table.clear(State.MessageTimes)
	table.clear(logs)

	status.Text = "● AB READY"
	status.TextColor3 = Color3.fromRGB(80, 220, 130)

	startButton.Text = "START AB"

	addLog("AB System reset.")

	updateStats()
end

--------------------------------------------------------
-- READ SETTINGS
--------------------------------------------------------

local function readSettings()
	local rate = tonumber(rateBox.Text)
	local duration = tonumber(durationBox.Text)
	local limit = tonumber(limitBox.Text)

	if not rate or rate < 1 then
		return false, "Invalid rate."
	end

	if not duration or duration < 1 then
		return false, "Invalid duration."
	end

	if not limit or limit < 1 then
		return false, "Invalid rate limit."
	end

	Config.MessagesPerSecond = math.clamp(rate, 1, 100)
	Config.Duration = math.clamp(duration, 1, 300)
	Config.RateLimit = math.clamp(limit, 1, 100)

	rateBox.Text = tostring(Config.MessagesPerSecond)
	durationBox.Text = tostring(Config.Duration)
	limitBox.Text = tostring(Config.RateLimit)

	return true
end

--------------------------------------------------------
-- TEST
--------------------------------------------------------

local function runTest()
	if State.Running then
		return
	end

	local valid, errorMessage = readSettings()

	if not valid then
		addLog(errorMessage, Color3.fromRGB(255, 100, 100))
		return
	end

	reset()

	State.Running = true
	State.StartTime = os.clock()

	status.Text = "● AB RUNNING"
	status.TextColor3 = Color3.fromRGB(255, 205, 75)

	startButton.Text = "RUNNING..."

	addLog("AB Test started.", Color3.fromRGB(100, 255, 150))

	local interval = 1 / Config.MessagesPerSecond
	local finishTime = os.clock() + Config.Duration

	while State.Running and not State.StopRequested do
		if os.clock() >= finishTime then
			break
		end

		State.Generated += 1

		local messageID = State.Generated

		local success, accepted = pcall(function()
			return checkRateLimit()
		end)

		if success then
			if accepted then
				State.Accepted += 1

				addLog(
					string.format(
						"[AB ACCEPTED] Message #%d",
						messageID
					),
					Color3.fromRGB(100, 220, 140)
				)
			else
				State.Blocked += 1

				addLog(
					string.format(
						"[AB RATE LIMIT] Message #%d",
						messageID
					),
					Color3.fromRGB(255, 190, 70)
				)
			end
		else
			State.Errors += 1

			addLog(
				"[AB ERROR] Operation failed.",
				Color3.fromRGB(255, 90, 90)
			)
		end

		updateStats()

		task.wait(interval)
	end

	State.EndTime = os.clock()
	State.Running = false

	if State.StopRequested then
		status.Text = "● AB STOPPED"
		status.TextColor3 = Color3.fromRGB(255, 120, 120)

		addLog("AB Test stopped by user.")
	else
		status.Text = "● AB COMPLETED"
		status.TextColor3 = Color3.fromRGB(80, 220, 130)

		addLog("AB Test completed successfully.")
	end

	startButton.Text = "START AB"

	updateStats()
end

--------------------------------------------------------
-- STOP
--------------------------------------------------------

local function stopTest()
	if not State.Running then
		return
	end

	State.StopRequested = true
	State.Running = false

	status.Text = "● AB STOPPING..."
	status.TextColor3 = Color3.fromRGB(255, 170, 70)

	addLog("AB Stop requested.")
end

