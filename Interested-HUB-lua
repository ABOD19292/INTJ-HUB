-- قائمة الأوامر الأصلية التي طلبتها
local rawCommands = {
    "/AP SA", "/INF", "/JAIL SA", "/ICE SA", "/KILL SA", "/RESPAWN SA", 
    "/CMDBAR SA", "/LOGS SA", "/CLOGS SA", "/FLING SA", "/REFRESH SA", 
    "/FIRE SA", "/TELEPORT SA", "/HANDTO SA", "/BOX SA", "/DOG SA", 
    "/WORM SA", "/CHIBIFY SA", "/PLUSHIFY SA", "/FREAKY SA", "/FROGLY SA", 
    "/BIGIFY SA", "/DINOFY SA", "/FATIFY SA", "/GHOST SA", "/SQUASH SA", 
    "/FAT SA", "/THIN SA", "/GIANTDWARF SA", "/DWARF SA", "/HEADSIZE SA", 
    localPlayer, "/BODYTYPESCALE SA", "/DEPTH SA", "/POTATOHEAD SA"
}

-- دالة لتحديث النصوص والروابط تلقائياً
local function updateData()
    local saInput = TargetBox.Text:lower()
    
    -- 1. دمج الأوامر كلها ببعضها مع استبدال SA
    local compiledCmds = {}
    for _, cmd in ipairs(rawCommands) do
        local finalCmd = string.gsub(cmd, "SA", saInput)
        table.insert(compiledCmds, finalCmd)
    end
    
    local fullString = table.concat(compiledCmds, " ")
    CopyAllCmdsButton.Text = "نسخ الأوامر المتسلسلة:\n" .. fullString

    -- تخزين النص المؤقت للنسخ
    CopyAllCmdsButton.MouseButton1Click:Once(function()
        if setclipboard then
            setclipboard(fullString)
            CopyAllCmdsButton.Text = "تم نسخ جميع الأوامر بنجاح! ✓"
            task.wait(1.5)
            updateData()
        end
    end)

    -- 2. تجهيز زر res للجميع (أول حرفين)
    local abbreviations = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local pName = player.Name
        if #pName >= 2 then
            table.insert(abbreviations, string.lower(string.sub(pName, 1, 2)))
        else
            table.insert(abbreviations, string.lower(pName))
        end
    end
    
    local resString = ";res " .. table.concat(abbreviations, ",")
    ResAllButton.Text = "نسخ الأوامر للجميع:\n" .. resString
end

TargetBox:GetPropertyChangedSignal("Text"):Connect(updateData)
Players.PlayerAdded:Connect(updateData)
Players.PlayerRemoving:Connect(updateData)

