-- List of commands template
local baseCommands = {
    "/AP SA", "/INF", "/JAIL SA", "/ICE SA", "/KILL SA", "/RESPAWN SA", 
    "/CMDBAR SA", "/LOGS SA", "/CLOGS SA", "/FLING SA", "/REFRESH SA", 
    "/FIRE SA", "/TELEPORT SA", "/HANDTO SA", "/BOX SA", "/DOG SA", 
    "/WORM SA", "/CHIBIFY SA", "/PLUSHIFY SA", "/FREAKY SA", "/FROGLY SA", 
    "/BIGIFY SA", "/DINOFY SA", "/FATIFY SA", "/GHOST SA", "/SQUASH SA", 
    "/FAT SA", "/THIN SA", "/GIANTDWARF SA", "/DWARF SA", "/HEADSIZE SA", 
    "/BODYTYPESCALE SA", "/DEPTH SA", "/POTATOHEAD SA"
}

-- Function to update commands and buttons based on target input
local function updateCommands()
    -- Clear old command buttons
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local saInput = TargetBox.Text:lower()
    
    -- Build individual command buttons
    for i, cmd in ipairs(baseCommands) do
        local finalCmd = string.gsub(cmd, "SA", saInput)
        
        local cmdButton = Instance.new("TextButton")
        cmdButton.Size = UDim2.new(1, -10, 0, 30)
        cmdButton.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        cmdButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        cmdButton.TextSize = 12
        cmdButton.Text = finalCmd
        cmdButton.Parent = ScrollingFrame
        
        -- Copy to clipboard on click
        cmdButton.MouseButton1Click:Connect(function()
            if setclipboard then
                setclipboard(finalCmd)
                cmdButton.Text = "تم النسخ! ✓"
                task.wait(1)
                cmdButton.Text = finalCmd
            end
        end)
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y)

    -- Build Res All string (First 2 letters of each player)
    local abbreviations = {}
    for _, player in ipairs(Players:GetPlayers()) do
        local pName = player.Name
        if #pName >= 2 then
            table.insert(abbreviations, string.lower(string.sub(pName, 1, 2)))
        else
            table.insert(abbreviations, string.lower(pName))
        end
    end
    
    local resString = ";res " .. table.concat(abbreviations, ",")
    ResAllButton.Text = resString
end

TargetBox:GetPropertyChangedSignal("Text"):Connect(updateCommands)
Players.PlayerAdded:Connect(updateCommands)
Players.PlayerRemoving:Connect(updateCommands)

-- Copy Res All string on click
ResAllButton.MouseButton1Click:Connect(function()
    if setclipboard then
        setclipboard(ResAllButton.Text)
        local old = ResAllButton.Text
        ResAllButton.Text = "تم نسخ الكل! ✓"
        task.wait(1)
        ResAllButton.Text = old
    end
end)

-- Toggle UI visibility
ToggleButton.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- Initial load
updateCommands()
