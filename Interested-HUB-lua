local CustomChatRemotes = {}

-- // --- 1. فاحص ريموتات الشات المخصص للماب (Custom Chat Finder) --- //
local function ScanForCustomChatRemotes()
    CustomChatRemotes = {}
    local keywords = {"chat", "say", "msg", "message", "talk", "send", "speak", "text", "shout", "cmd", "command"}
    
    local function search(parent)
        pcall(function()
            for _, obj in ipairs(parent:GetDescendants()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    local nameLower = string.lower(obj.Name)
                    for _, kw in ipairs(keywords) do
                        if string.find(nameLower, kw) then
                            table.insert(CustomChatRemotes, obj)
                            break
                        end
                    end
                end
            end
        end)
    end

    search(ReplicatedStorage)
    search(game:GetService("Workspace"))
    search(LocalPlayer)
end

ScanForCustomChatRemotes()

-- // --- 2. محرك الشات الشامل --- //
local function UniversalSendChat(msg)
    if not msg or msg == "" then return end

    for _, remote in ipairs(CustomChatRemotes) do
        pcall(function()
            if remote:IsA("RemoteEvent") then
                remote:FireServer(msg)
                remote:FireServer(msg, "All")
                remote:FireServer("Message", msg)
            elseif remote:IsA("RemoteFunction") then
                remote:InvokeServer(msg)
                remote:InvokeServer(msg, "All")
            end
        end)
    end

    pcall(function()
        if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local textChannels = TextChatService:FindFirstChild("TextChannels")
            if textChannels then
                local mainChan = textChannels:FindFirstChild("RBXGeneral") or textChannels:FindFirstChild("All")
                if mainChan then
                    mainChan:SendAsync(msg)
                end
            end
        end
    end)

    pcall(function()
        local chatEvents = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
        if chatEvents then
            local sayRemote = chatEvents:FindFirstChild("SayMessageRequest")
            if sayRemote and sayRemote:IsA("RemoteEvent") then
                sayRemote:FireServer(msg, "All")
            end
        end
    end)
end

