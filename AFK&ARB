PlayerListFrame.Visible = false
PlayerListFrame.ZIndex = 5
PlayerListFrame.Parent = TargetHolder

local ListLayout = Instance.new("UIListLayout")
ListLayout.Parent = PlayerListFrame

local selectedPlayer = LocalPlayer.Name

local function updatePlayerList()
    for _, child in pairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for _, player in pairs(Players:GetPlayers()) do
        local pBtn = Instance.new("TextButton")
        pBtn.Size = UDim2.new(1, 0, 0, 25)
        pBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        pBtn.Text = player.Name
        pBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        pBtn.Font = Enum.Font.Gotham
        pBtn.TextSize = 12
        pBtn.ZIndex = 6
        pBtn.Parent = PlayerListFrame
        
        pBtn.MouseButton1Click:Connect(function()
            selectedPlayer = player.Name
            TargetText.Text = "اللاعب: " .. player.Name
            PlayerListFrame.Visible = false
        end)
    end
end

TargetText.MouseButton1Click:Connect(function()
    updatePlayerList()
    PlayerListFrame.Visible = not PlayerListFrame.Visible
end)

