local function makeButton(text, bgCol, textCol)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 38)
    btn.BackgroundColor3 = bgCol or Color3.fromRGB(25, 25, 25)
    btn.Text = text
    btn.TextColor3 = textCol or Color3.fromRGB(255, 50, 50)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 14
    btn.Parent = Sidebar
    
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = btn
    
    local s = Instance.new("UIStroke")
    s.Color = Color3.fromRGB(255, 0, 0)
    s.Parent = btn
    return btn
end

