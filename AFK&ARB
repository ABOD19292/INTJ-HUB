-- [[ 1. صائد الريموتات الذكي (تجاهل شات روبلوكس العادي) ]] --
local DetectedRemotes = {}

local function ScanForRemotes()
    table.clear(DetectedRemotes)
    local scanAreas = {
        game:GetService("ReplicatedStorage"),
        LocalPlayer.Backpack,
        LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    }
    
    for _, area in ipairs(scanAreas) do
        for _, obj in pairs(area:GetDescendants()) do
            -- نبحث عن الريموتات ونستثني مجلد شات روبلوكس الأساسي
            if obj:IsA("RemoteEvent") then
                local isDefaultChat = false
                pcall(function()
                    if obj:IsDescendantOf(game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents")) then
                        isDefaultChat = true
                    end
                end)
                
                if not isDefaultChat then
                    table.insert(DetectedRemotes, obj)
                end
            end
        end
    end
end

