}

-- [[ نظام النسخ + إرسال السكربت بالسرعة ]] --
local spamConnection = nil

local function Action(cmdTemplate)
    if spamConnection then
        spamConnection:Disconnect()
        spamConnection = nil
    end
    
    -- استبدال اسم اللاعب في السكربت
    local finalCmd = string.gsub(cmdTemplate, "%[TARGET%]", selectedPlayer)
    
    -- 1. النسخ إلى Clipboard
    pcall(function()
        setclipboard(finalCmd)
    end)
    
    -- 2. إرسال إلى ريموت اللعبة بـ RunService
    local remote = getRemote()
    if remote then
        spamConnection = RunService.Heartbeat:Connect(function()
            pcall(function()
                remote:FireServer(finalCmd)
            end)
        end)
    end
end

-- ربط الأزرار بالوظائف
ModBtn.MouseButton1Click:Connect(function() Action(Commands.Mod) end)
HeadBtn.MouseButton1Click:Connect(function() Action(Commands.HeadAdmin) end)
MysteryBtn.MouseButton1Click:Connect(function() Action(Commands.Mystery) end)

StopBtn.MouseButton1Click:Connect(function()
