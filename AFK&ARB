-- [[ 5. الأوامر ونظام الإرسال الموزون ]] --
local Commands = {
    Mod = "@cmdbar [TARGET] @logs [TARGET] @re [TARGET] @kill [TARGET] @nv [TARGET] @ice [TARGET] @jc [TARGET] @paint [TARGET] @worm [TARGET] @char [TARGET] c7v @tp [TARGET]",
    Admin = "?EXPLODE [TARGET] ?WARP [TARGET] ?JAIL [TARGET] ?ICE [TARGET] ?LOOPWARF [TARGET] ?LOGS [TARGET] ?CLOGS [TARGET] ?CHATLOGS [TARGET] ?NV [TARGET] ?CMDBAR [TARGET] ?CHAR [TARGET] MIR' ?ALERT [TARGET] ?AURA [TARGET] ?EXPLODE"
}

local isSending = false

local function ExecuteAction(cmdTemplate)
    isSending = false 
    task.wait(0.1)
    isSending = true
    
    local finalCmd = string.gsub(cmdTemplate, "%[TARGET%]", selectedPlayer)
    
    ScanForRemotes()
    
    task.spawn(function()
        while isSending do
            for _, remote in ipairs(DetectedRemotes) do
                pcall(function()
                    remote:FireServer(finalCmd)
                end)
            end
            task.wait(1) 
        end
    end)
end

ModBtn.MouseButton1Click:Connect(function() ExecuteAction(Commands.Mod) end)
HeadBtn.MouseButton1Click:Connect(function() ExecuteAction(Commands.Admin) end)
MysteryBtn.MouseButton1Click:Connect(function() ExecuteAction(Commands.Admin) end)

StopBtn.MouseButton1Click:Connect(function()
    isSending = false
end)
