-- [[ جلب الريموت تلقائياً ]] --
local function getRemote()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local teddy = character:FindFirstChild("Teddy") or LocalPlayer.Backpack:FindFirstChild("Teddy")
    if teddy and teddy:FindFirstChild("BounceEvent") then
        return teddy.BounceEvent
    end
    return nil
end

